 static inline bool
 acd_runtime_reference(const struct amdgpu_device *canned_template,
@@ -139,4 +140,54 @@ acd_runtime_overlay(const struct amdgpu_device *canned, const struct cobalt_gpu_
    return true;
 }
 
+static inline bool
+acd_runtime_firmware_overlay(const struct cobalt_gpu_info_v1 *identity,
+                             const struct cobalt_cp_firmware_v1 *firmware,
+                             struct amdgpu_device *device)
+{
+   struct cobalt_gpu_info_v1 checked_identity;
+   struct cobalt_cp_firmware_v1 decoded;
+   uint32_t gc_version;
+   enum radeon_family family;
+   const char *name;
+
+   if (!identity || !firmware || !device ||
+       !cobalt_gpu_info_v1_decode(identity, sizeof(*identity), &checked_identity) ||
+       !cobalt_cp_firmware_v1_decode(firmware, sizeof(*firmware), &checked_identity, &decoded))
+      return false;
+
+   gc_version = (checked_identity.gc_major << 16) | (checked_identity.gc_minor << 8) |
+                checked_identity.gc_revision;
+   if (checked_identity.gfx_target == COBALT_GPU_GFX_TARGET_1200 &&
+       checked_identity.pci_device == 0x7590u) {
+      family = CHIP_GFX1200;
+      name = "gfx1200";
+   } else if (checked_identity.gfx_target == COBALT_GPU_GFX_TARGET_1201 &&
+              (checked_identity.pci_device == 0x7550u || checked_identity.pci_device == 0x7551u)) {
+      family = CHIP_GFX1201;
+      name = "gfx1201";
+   } else {
+      return false;
+   }
+
+   if (!device->name || strcmp(device->name, name) || device->radeon_family != family ||
+       device->dev.device_id != checked_identity.pci_device ||
+       device->dev.pci_rev != checked_identity.pci_revision ||
+       device->hw_ip_gfx.hw_ip_version_major != checked_identity.gc_major ||
+       device->hw_ip_gfx.hw_ip_version_minor != checked_identity.gc_minor ||
+       device->hw_ip_gfx.ip_discovery_version != gc_version ||
+       device->hw_ip_compute.hw_ip_version_major != checked_identity.gc_major ||
+       device->hw_ip_compute.hw_ip_version_minor != checked_identity.gc_minor ||
+       device->hw_ip_compute.ip_discovery_version != gc_version)
+      return false;
+
+   device->fw_gfx_me.ver = decoded.me_version;
+   device->fw_gfx_me.feature = decoded.me_feature;
+   device->fw_gfx_pfp.ver = decoded.pfp_version;
+   device->fw_gfx_pfp.feature = decoded.pfp_feature;
+   device->fw_gfx_mec.ver = decoded.mec_version;
+   device->fw_gfx_mec.feature = decoded.mec_feature;
+   return true;
+}
+
 #endif
