index 0000000..faae069
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_identity.h
@@ -0,0 +1,28 @@
+#ifndef AC_DARWIN_IDENTITY_H
+#define AC_DARWIN_IDENTITY_H
+
+#include "cobalt_gpu_info.h"
+
+static inline const char *
+acd_identity_decode(const void *bytes, size_t length, struct cobalt_gpu_info_v1 *out)
+{
+   if (!bytes) {
+      memset(out, 0, sizeof(*out));
+      return "missing Cobalt,GpuInfo-v1; update the Cobalt kernel driver";
+   }
+   if (!cobalt_gpu_info_v1_decode(bytes, length, out))
+      return "malformed Cobalt,GpuInfo-v1";
+   if (out->gfx_target != COBALT_GPU_GFX_TARGET_1201)
+      return "gfx1200 / Navi 44 is unsupported and remains disabled";
+   if (!(out->flags & COBALT_GPU_INFO_BRINGUP_ENABLED))
+      return "Cobalt,GpuInfo-v1 bringup profile is disabled";
+   return NULL;
+}
+
+static inline int
+acd_identity_gc_matches(const struct cobalt_gpu_info_v1 *identity, uint32_t gc_version)
+{
+   return gc_version == ((identity->gc_major << 16) | (identity->gc_minor << 8) | identity->gc_revision);
+}
+
+#endif
