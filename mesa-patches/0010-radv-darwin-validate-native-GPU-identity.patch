+static int
+iokit_read_identity(io_service_t svc, struct cobalt_gpu_info_v1 *identity)
+{
+   io_registry_entry_t owner = svc;
+   bool release_owner = false;
+   if (IOObjectConformsTo(svc, ACD_SERVICE_ACCELERATOR)) {
+      io_registry_entry_t nub = IO_OBJECT_NULL;
+      if (IORegistryEntryGetParentEntry(svc, kIOServicePlane, &nub) != KERN_SUCCESS)
+         goto ancestry_error;
+      if (!IOObjectConformsTo(nub, "Navi48MetalNub")) {
+         IOObjectRelease(nub);
+         goto ancestry_error;
+      }
+      kern_return_t kr = IORegistryEntryGetParentEntry(nub, kIOServicePlane, &owner);
+      IOObjectRelease(nub);
+      if (kr != KERN_SUCCESS)
+         goto ancestry_error;
+      release_owner = true;
+   }
+   if (!IOObjectConformsTo(owner, ACD_SERVICE_BRINGUP)) {
+      if (release_owner)
+         IOObjectRelease(owner);
+      goto ancestry_error;
+   }
+
+   CFTypeRef property = IORegistryEntryCreateCFProperty(owner, CFSTR(COBALT_GPU_INFO_PROPERTY),
+                                                       kCFAllocatorDefault, 0);
+   if (release_owner)
+      IOObjectRelease(owner);
+   const char *reason;
+   if (!property) {
+      reason = acd_identity_decode(NULL, 0, identity);
+   } else if (CFGetTypeID(property) != CFDataGetTypeID()) {
+      reason = "Cobalt,GpuInfo-v1 must be CFData";
+   } else {
+      reason = acd_identity_decode(CFDataGetBytePtr((CFDataRef)property),
+                                   CFDataGetLength((CFDataRef)property), identity);
+   }
+   if (property)
+      CFRelease(property);
+   if (!reason)
+      return 0;
+   fprintf(stderr, "radv-darwin: native identity refused before IOServiceOpen: %s\n", reason);
+   return -ENODEV;
+
+ancestry_error:
+   fprintf(stderr, "radv-darwin: native identity refused before IOServiceOpen: expected selected "
+                   "Navi48Bringup or Navi48Accelerator -> Navi48MetalNub -> Navi48Bringup\n");
+   return -ENODEV;
+}
+
