    if (!svc) {
@@ -76,6 +130,13 @@ acd_kext_open_iokit(struct acd_kext **out)
       return -ENODEV;
    }
 
+   struct cobalt_gpu_info_v1 identity = {0};
+   int r = iokit_read_identity(svc, &identity);
+   if (r) {
+      IOObjectRelease(svc);
+      return r;
+   }
+
    io_connect_t conn = 0;
    kern_return_t kr = KERN_FAILURE;
    /* A previous client (e.g. RADV's throw-away device used for the physical-device query) may
@@ -109,6 +170,6 @@ acd_kext_open_iokit(struct acd_kext **out)
       .unmap = iokit_unmap,
       .close = iokit_close,
    };
-   *out = acd_kext_create(&ops, c);
+   *out = acd_kext_create_with_identity(&ops, c, &identity);
    return *out ? 0 : -ENOMEM;
 }
