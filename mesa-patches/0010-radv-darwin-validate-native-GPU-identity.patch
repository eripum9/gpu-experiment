index 0000000..667239a
--- /dev/null
+++ b/src/amd/common/darwin/test/acd_identity_test.c
@@ -0,0 +1,65 @@
+#include "ac_darwin_identity.h"
+
+#include <assert.h>
+#include <stdio.h>
+
+static struct cobalt_gpu_info_v1
+record(void)
+{
+   return (struct cobalt_gpu_info_v1){
+      .version = COBALT_GPU_INFO_VERSION,
+      .size = sizeof(struct cobalt_gpu_info_v1),
+      .flags = COBALT_GPU_INFO_CAPACITY_VALID | COBALT_GPU_INFO_BRINGUP_ENABLED,
+      .pci_vendor = 0x1002,
+      .pci_device = 0x7551,
+      .pci_revision = 0xc8,
+      .pci_subsystem_vendor = 0x1da2,
+      .pci_subsystem_device = 0xe499,
+      .gfx_target = COBALT_GPU_GFX_TARGET_1201,
+      .gc_major = 12,
+      .gc_revision = 1,
+      .shader_engines = 4,
+      .shader_arrays_per_engine = 2,
+      .wgp_per_array = 4,
+      .cu_per_array = 8,
+      .max_compute_units = 64,
+      .render_backends_per_engine = 4,
+      .max_waves_per_simd = 16,
+   };
+}
+
+int main(void)
+{
+   struct cobalt_gpu_info_v1 in = record(), out;
+   assert(acd_identity_decode(&in, sizeof(in), &out) == NULL);
+   assert(out.pci_device == 0x7551 && out.pci_revision == 0xc8);
+   assert(out.pci_subsystem_vendor == 0x1da2 && out.pci_subsystem_device == 0xe499);
+   assert(acd_identity_gc_matches(&out, 0xc0001));
+   assert(!acd_identity_gc_matches(&out, 0xc0000));
+   assert(!acd_identity_gc_matches(&out, 0));
+   assert(acd_identity_decode(NULL, 0, &out));
+   assert(out.version == 0 && out.pci_device == 0);
+   assert(acd_identity_decode(&in, sizeof(in) - 1, &out));
+   in.reserved[7] = 1;
+   assert(acd_identity_decode(&in, sizeof(in), &out));
+   in = record();
+   in.flags &= ~COBALT_GPU_INFO_BRINGUP_ENABLED;
+   assert(acd_identity_decode(&in, sizeof(in), &out));
+   in.pci_device = 0x7590;
+   in.gfx_target = COBALT_GPU_GFX_TARGET_1200;
+   in.gc_revision = 0;
+   assert(cobalt_gpu_info_v1_decode(&in, sizeof(in), &out));
+   assert(acd_identity_decode(&in, sizeof(in), &out));
+   in.flags |= COBALT_GPU_INFO_BRINGUP_ENABLED;
+   assert(!cobalt_gpu_info_v1_decode(&in, sizeof(in), &out));
+   assert(acd_identity_decode(&in, sizeof(in), &out));
+   in = record();
+   in.pci_device = 0x7550;
+   assert(acd_identity_decode(&in, sizeof(in), &out) == NULL);
+   unsigned char unaligned[sizeof(in) + 1];
+   memcpy(unaligned + 1, &in, sizeof(in));
+   assert(acd_identity_decode(unaligned + 1, sizeof(in), &out) == NULL);
+   assert(acd_identity_decode(&out, sizeof(out), &out) == NULL);
+   puts("acd_identity_test: passed");
+   return 0;
+}
diff --git a/src/amd/common/darwin/test/acd_iokit_test.c b/src/amd/common/darwin/test/acd_iokit_test.c
new file mode 100644
index 0000000..59d328a
--- /dev/null
+++ b/src/amd/common/darwin/test/acd_iokit_test.c
@@ -0,0 +1,235 @@
+#include "ac_darwin_kext.h"
+#include <IOKit/IOKitLib.h>
+
+#include <assert.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifdef ACD_TEST_ALLOCATOR
+#undef calloc
+static unsigned alloc_calls, fail_alloc_call;
+void *acd_test_calloc(size_t count, size_t size)
+{
+   if (++alloc_calls == fail_alloc_call)
+      return NULL;
+   return calloc(count, size);
+}
+#endif
+
+enum { BRINGUP = 1, ACCELERATOR, NUB, WRONG };
+static struct cobalt_gpu_info_v1 wire;
+static unsigned refs[5], matches, opens, closes, property_refs, reads;
+static io_service_t selected;
+static io_registry_entry_t nub_parent, accelerator_parent;
+static int property_kind, parent_failure, open_error;
+static CFIndex wire_length;
+
+static void reset(void)
+{
+   for (unsigned i = 0; i < 5; i++)
+      assert(refs[i] == 0);
+   assert(property_refs == 0);
+#ifdef ACD_TEST_ALLOCATOR
+   alloc_calls = fail_alloc_call = 0;
+#endif
+   matches = opens = closes = reads = 0;
+   selected = BRINGUP;
+   nub_parent = BRINGUP;
+   accelerator_parent = NUB;
+   property_kind = 1;
+   parent_failure = open_error = 0;
+   wire_length = sizeof(wire);
+   wire = (struct cobalt_gpu_info_v1){
+      .version = 1, .size = sizeof(wire), .flags = 3,
+      .pci_vendor = 0x1002, .pci_device = 0x7551, .pci_revision = 0xc8,
+      .pci_subsystem_vendor = 0x1da2, .pci_subsystem_device = 0xe499,
+      .gfx_target = 1201, .gc_major = 12, .gc_revision = 1,
+      .shader_engines = 4, .shader_arrays_per_engine = 2, .wgp_per_array = 4,
+      .cu_per_array = 8, .max_compute_units = 64,
+      .render_backends_per_engine = 4, .max_waves_per_simd = 16,
+   };
+}
+
+CFMutableDictionaryRef IOServiceMatching(const char *name)
+{
+   return (void *)name;
+}
+io_service_t IOServiceGetMatchingService(mach_port_t port, CFMutableDictionaryRef matching)
+{
+   (void)port; (void)matching;
+   matches++;
+   if (selected)
+      refs[selected]++;
+   return selected;
+}
+int IOObjectConformsTo(io_object_t object, const char *name)
+{
+   assert(object && refs[object]);
+   return (object == BRINGUP && !strcmp(name, ACD_SERVICE_BRINGUP)) ||
+          (object == ACCELERATOR && !strcmp(name, ACD_SERVICE_ACCELERATOR)) ||
+          (object == NUB && !strcmp(name, "Navi48MetalNub"));
+}
+kern_return_t IOObjectRelease(io_object_t object)
+{
+   assert(object && refs[object]);
+   refs[object]--;
+   return KERN_SUCCESS;
+}
+kern_return_t IORegistryEntryGetParentEntry(io_registry_entry_t entry, const char *plane,
+                                           io_registry_entry_t *parent)
+{
+   assert(refs[entry] && !strcmp(plane, kIOServicePlane));
+   if ((int)entry == parent_failure)
+      return KERN_FAILURE;
+   *parent = entry == ACCELERATOR ? accelerator_parent : nub_parent;
+   refs[*parent]++;
+   return KERN_SUCCESS;
+}
+CFTypeRef IORegistryEntryCreateCFProperty(io_registry_entry_t entry, const char *key,
+                                         const void *allocator, uint32_t options)
+{
+   (void)allocator; (void)options;
+   assert(refs[entry] && entry == BRINGUP);
+   assert(!strcmp(key, COBALT_GPU_INFO_PROPERTY));
+   reads++;
+   if (!property_kind)
+      return NULL;
+   property_refs++;
+   return &wire;
+}
+CFTypeID CFGetTypeID(CFTypeRef property)
+{
+   assert(property == &wire && property_refs);
+   return property_kind;
+}
+CFTypeID CFDataGetTypeID(void) { return 1; }
+const uint8_t *CFDataGetBytePtr(CFDataRef property)
+{
+   assert(property == &wire && property_refs);
+   return (const uint8_t *)&wire;
+}
+CFIndex CFDataGetLength(CFDataRef property)
+{
+   assert(property == &wire && property_refs);
+   return wire_length;
+}
+void CFRelease(CFTypeRef property)
+{
+   assert(property == &wire && property_refs);
+   property_refs--;
+}
+kern_return_t IOServiceOpen(io_service_t service, mach_port_t task, uint32_t type, io_connect_t *conn)
+{
+   (void)task;
+   assert(service == selected && refs[service] && type == N48N_UC_TYPE);
+   assert(reads == 1 && property_refs == 0);
+   opens++;
+   if (open_error)
+      return open_error;
+   *conn = 99;
+   return KERN_SUCCESS;
+}
+kern_return_t IOServiceClose(io_connect_t conn)
+{
+   assert(conn == 99);
+   closes++;
+   return KERN_SUCCESS;
+}
+kern_return_t IOConnectCallMethod(io_connect_t conn, uint32_t sel, const uint64_t *sin, uint32_t nsin,
+                                  const void *stin, size_t stinsz, uint64_t *sout, uint32_t *nsout,
+                                  void *stout, size_t *stoutsz)
+{
+   (void)conn; (void)sel; (void)sin; (void)nsin; (void)stin; (void)stinsz;
+   (void)sout; (void)nsout; (void)stout; (void)stoutsz;
+   assert(0);
+   return KERN_FAILURE;
+}
+kern_return_t IOConnectMapMemory64(io_connect_t conn, uint32_t handle, mach_port_t task,
+                                   mach_vm_address_t *addr, mach_vm_size_t *size, uint32_t options)
+{
+   (void)conn; (void)handle; (void)task; (void)addr; (void)size; (void)options;
+   assert(0);
+   return KERN_FAILURE;
+}
+kern_return_t IOConnectUnmapMemory64(io_connect_t conn, uint32_t handle, mach_port_t task,
+                                     mach_vm_address_t addr)
+{
+   (void)conn; (void)handle; (void)task; (void)addr;
+   assert(0);
+   return KERN_FAILURE;
+}
+int acd_mock_open(struct acd_kext **out) { (void)out; return -ENODEV; }
+
+static void rejected(void)
+{
+   struct acd_kext *k = (void *)1;
+   assert(acd_kext_open_iokit(&k) == -ENODEV);
+   assert(k == NULL && opens == 0 && closes == 0 && matches == 1);
+   for (unsigned i = 0; i < 5; i++)
+      assert(refs[i] == 0);
+   assert(property_refs == 0);
+}
+
+int main(void)
+{
+   reset();
+   struct acd_kext *k;
+   assert(acd_kext_open_iokit(&k) == 0);
+   const struct cobalt_gpu_info_v1 *snapshot = acd_kext_identity(k);
+   assert(snapshot && snapshot != &wire && snapshot->pci_device == 0x7551);
+   assert(snapshot->pci_revision == 0xc8 && snapshot->pci_subsystem_device == 0xe499);
+   wire.pci_device = 0x7550;
+   selected = ACCELERATOR;
+   for (unsigned i = 0; i < 10; i++)
+      assert(acd_kext_identity(k) == snapshot && snapshot->pci_device == 0x7551);
+   assert(matches == 1 && reads == 1 && opens == 1 && closes == 0);
+   acd_kext_destroy(k);
+   assert(closes == 1);
+
+   reset();
+   selected = ACCELERATOR;
+   assert(acd_kext_set_service_class(ACD_SERVICE_ACCELERATOR) == 0);
+   assert(acd_kext_open_iokit(&k) == 0);
+   assert(acd_kext_identity(k)->pci_device == 0x7551);
+   acd_kext_destroy(k);
+   assert(closes == 1);
+
+   reset(); property_kind = 0; rejected();
+   reset(); property_kind = 2; rejected();
+   reset(); wire_length--; rejected();
+   reset(); wire.version++; rejected();
+   reset(); wire.reserved[0] = 1; rejected();
+   reset(); wire.flags &= ~COBALT_GPU_INFO_BRINGUP_ENABLED; rejected();
+   reset(); wire.pci_device = 0x7590; wire.gfx_target = 1200; wire.gc_revision = 0;
+   wire.flags &= ~COBALT_GPU_INFO_BRINGUP_ENABLED; rejected();
+   reset(); selected = ACCELERATOR; parent_failure = ACCELERATOR; rejected();
+   reset(); selected = ACCELERATOR; accelerator_parent = WRONG; rejected();
+   reset(); selected = ACCELERATOR; parent_failure = NUB; rejected();
+   reset(); selected = ACCELERATOR; nub_parent = WRONG; rejected();
+   reset(); selected = WRONG; rejected();
+   reset(); selected = IO_OBJECT_NULL; rejected();
+   reset(); open_error = (int)ACD_KR_NOT_READY;
+   assert(acd_kext_open_iokit(&k) == -ENODEV && k == NULL);
+   assert(opens == 1 && closes == 0);
+   reset();
+
+#ifdef ACD_TEST_ALLOCATOR
+   fail_alloc_call = 1;
+   assert(acd_kext_open_iokit(&k) == -ENOMEM && k == NULL);
+   assert(opens == 1 && closes == 1);
+   reset();
+   fail_alloc_call = 2;
+   assert(acd_kext_open_iokit(&k) == -ENOMEM && k == NULL);
+   assert(opens == 1 && closes == 1);
+   reset();
+#endif
+
+   const struct acd_kext_ops ops = {0};
+   k = acd_kext_create(&ops, NULL);
+   assert(k && acd_kext_identity(k) == NULL);
+   acd_kext_destroy(k);
+   assert(acd_kext_identity(NULL) == NULL);
+   puts("acd_iokit_test: passed");
+   return 0;
+}
