diff --git a/src/amd/common/darwin/ac_darwin_runtime.h b/src/amd/common/darwin/ac_darwin_runtime.h
new file mode 100644
index 0000000..457b4b9
--- /dev/null
+++ b/src/amd/common/darwin/ac_darwin_runtime.h
@@ -0,0 +1,62 @@
+#ifndef AC_DARWIN_RUNTIME_H
+#define AC_DARWIN_RUNTIME_H
+
+#include <stdbool.h>
+#include <string.h>
+
+#include "common/amdgpu_devices.h"
+#include "cobalt_gfx_runtime.h"
+
+static inline bool
+acd_runtime_live_matches(const struct cobalt_gpu_info_v1 *identity,
+                         const struct cobalt_gfx_runtime_v1 *runtime,
+                         uint32_t gc_version, uint32_t gb_addr_config)
+{
+   return identity && runtime &&
+          runtime->gc_version == ((identity->gc_major << 16) | (identity->gc_minor << 8) |
+                                  identity->gc_revision) &&
+          runtime->gc_version == gc_version && runtime->gb_addr_config == gb_addr_config;
+}
+
+static inline bool
+acd_runtime_overlay(const struct amdgpu_device *canned, const struct cobalt_gpu_info_v1 *identity,
+                    const struct cobalt_gfx_runtime_v1 *runtime, struct amdgpu_device *out)
+{
+   struct cobalt_gfx_runtime_v1 decoded;
+   if (!identity || identity->gfx_target != COBALT_GPU_GFX_TARGET_1201 || !runtime ||
+       !cobalt_gfx_runtime_v1_decode(runtime, sizeof(*runtime), identity, &decoded))
+      return false;
+
+   bool found = false;
+   for (uint32_t i = 0; i < canned->mmr_reg_count; i++)
+      found |= canned->mmr_regs[i * 3] == 0x263e;
+   if (!found)
+      return false;
+
+   *out = *canned;
+   out->dev.device_id = identity->pci_device;
+   out->dev.pci_rev = identity->pci_revision;
+   out->dev.num_shader_engines = decoded.shader_engines;
+   out->dev.num_shader_arrays_per_engine = decoded.shader_arrays_per_engine;
+   out->dev.num_cu_per_sh = decoded.cu_per_array;
+   out->dev.cu_active_number = decoded.active_cu_count;
