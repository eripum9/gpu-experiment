+   assert(out.dev.enabled_rb_pipes_mask != 0xffff && out.dev.cu_bitmap[3][1] == 0);
+   runtime.cu_bitmap[0][0] = 0xff;
+   assert(out.dev.cu_bitmap[0][0] == 0x3f);
+   assert(!acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   assert(!memcmp(&out, &expected, sizeof(out)));
+   assert(!memcmp(&out, &expected, sizeof(out)));
+   runtime.cu_bitmap[0][0] = 0x3f;
+   assert(!acd_runtime_overlay(&canned, &identity, NULL, &out));
+   canned.mmr_reg_count = 0;
+   assert(!acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   canned = original;
+
+   identity.shader_engines = runtime.shader_engines = 2;
+   identity.max_compute_units = 32;
+   identity.render_backends_per_engine = runtime.render_backends_per_engine = 2;
+   runtime.active_sa_mask = 0xf;
+   runtime.active_rb_mask = 0x7;
+   runtime.active_cu_count = 24;
+   memset(runtime.cu_bitmap, 0, sizeof(runtime.cu_bitmap));
+   runtime.cu_bitmap[0][0] = runtime.cu_bitmap[0][1] = 0xff;
+   runtime.cu_bitmap[1][0] = runtime.cu_bitmap[1][1] = 0xf;
+   assert(acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   assert(out.dev.num_shader_engines == 2 && out.dev.num_shader_arrays_per_engine == 2);
+   assert(out.dev.num_cu_per_sh == 8 && out.dev.cu_active_number == 24);
+   assert(out.dev.num_rb_pipes == 4 && out.dev.enabled_rb_pipes_mask == 0x7);
+   assert(out.dev.cu_bitmap[2][0] == 0 && out.dev.cu_bitmap[3][1] == 0);
+   assert(out.hw_ip_gfx.ip_discovery_version == 0xc0001);
+   assert(out.hw_ip_compute.ip_discovery_version == 0xc0001);
+
+   identity.flags &= ~COBALT_GPU_INFO_BRINGUP_ENABLED;
+   identity.pci_device = 0x7590;
+   identity.gfx_target = 1200;
+   identity.gc_revision = 0;
+   runtime.gc_version = 0xc0000;
+   assert(cobalt_gfx_runtime_v1_decode(&runtime, sizeof(runtime), &identity, &decoded));
+   assert(acd_identity_decode(&identity, sizeof(identity), &identity));
+   assert(!acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   puts("acd_runtime_test: passed");
+   return 0;
+}
