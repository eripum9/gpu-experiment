+#include "ac_darwin_runtime.h"
+#include "ac_darwin_identity.h"
+
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+   struct cobalt_gpu_info_v1 identity = {
+      .version = 1, .size = sizeof(identity), .flags = 3,
+      .pci_vendor = 0x1002, .pci_device = 0x7551, .pci_revision = 0xc8,
+      .gfx_target = 1201, .gc_major = 12, .gc_revision = 1,
+      .shader_engines = 4, .shader_arrays_per_engine = 2, .wgp_per_array = 4,
+      .cu_per_array = 8, .max_compute_units = 64,
+      .render_backends_per_engine = 4, .max_waves_per_simd = 16,
+   };
+   struct cobalt_gfx_runtime_v1 runtime = {
+      .version = 1, .size = sizeof(runtime), .flags = COBALT_GFX_RUNTIME_VALID,
+      .gc_version = 0xc0001, .gb_addr_config = 0x08200544,
+      .shader_engines = 4, .shader_arrays_per_engine = 2, .cu_per_array = 8,
+      .render_backends_per_engine = 4, .active_sa_mask = 0x7f,
+      .active_rb_mask = 0x3ff3, .active_cu_count = 38,
+      .cu_bitmap = {{0x3f, 0xcf}, {0xff, 0xf}, {0xf0, 0x3}, {0xff, 0}},
+   };
+   struct cobalt_gfx_runtime_v1 decoded;
+   assert(cobalt_gfx_runtime_v1_decode(&runtime, sizeof(runtime), &identity, &decoded));
+   assert(acd_runtime_live_matches(&identity, &runtime, 0xc0001, 0x08200544));
+   assert(!acd_runtime_live_matches(&identity, &runtime, 0xc0000, 0x08200544));
+   assert(!acd_runtime_live_matches(&identity, &runtime, 0xc0001, 0x08200545));
+   assert(!acd_runtime_live_matches(NULL, &runtime, 0xc0001, 0x08200544));
+   assert(!acd_runtime_live_matches(&identity, NULL, 0xc0001, 0x08200544));
+
+   struct amdgpu_device canned = {
+      .name = "gfx1201", .radeon_family = CHIP_GFX1201,
+      .hw_ip_gfx = {.hw_ip_version_major = 10, .hw_ip_version_minor = 1,
+                    .available_rings = 1, .ip_discovery_version = 0xa0100},
+      .hw_ip_compute = {.hw_ip_version_major = 10, .hw_ip_version_minor = 1,
+                        .available_rings = 15, .ip_discovery_version = 0xa0100},
+      .fw_gfx_me = {.ver = 2590, .feature = 29},
+      .fw_gfx_pfp = {.ver = 2630, .feature = 29},
+      .fw_gfx_mec = {.ver = 2800, .feature = 29},
+      .mmr_regs = {0x263e, UINT32_MAX, 0x08200545, 0x1000, UINT32_MAX, 0x12345678},
+      .mmr_reg_count = 2,
+      .dev = {
+         .device_id = 0x7550, .pci_rev = 0xc0,
+         .num_shader_engines = 4, .num_shader_arrays_per_engine = 2,
+         .num_cu_per_sh = 8, .cu_active_number = 64,
+         .cu_bitmap = {{0xff, 0xff, 0xff, 0xff}, {0xff, 0xff, 0xff, 0xff},
+                       {0xff, 0xff, 0xff, 0xff}, {0xff, 0xff, 0xff, 0xff}},
+         .enabled_rb_pipes_mask = 0xffff, .num_rb_pipes = 16,
+         .gpu_counter_freq = 100000, .max_engine_clock = 2460000,
+         .max_memory_clock = 1258000, .gl2c_cache_size = 8192,
+         .virtual_address_offset = 0x10000, .virtual_address_max = UINT64_C(0x800000000000),
+      },
+      .mem = {.vram = {.total_heap_size = UINT64_C(17095983104)}},
+   };
+   struct amdgpu_device original = canned, expected = canned, out;
+   expected.dev.device_id = 0x7551;
+   expected.dev.pci_rev = 0xc8;
+   expected.dev.cu_active_number = 38;
+   memset(expected.dev.cu_bitmap, 0, sizeof(expected.dev.cu_bitmap));
+   for (unsigned se = 0; se < 4; se++)
+      for (unsigned sa = 0; sa < 2; sa++)
+         expected.dev.cu_bitmap[se][sa] = runtime.cu_bitmap[se][sa];
+   expected.dev.enabled_rb_pipes_mask = 0x3ff3;
+   expected.mmr_regs[2] = 0x08200544;
+   expected.hw_ip_gfx.hw_ip_version_major = expected.hw_ip_compute.hw_ip_version_major = 12;
+   expected.hw_ip_gfx.hw_ip_version_minor = expected.hw_ip_compute.hw_ip_version_minor = 0;
+   expected.hw_ip_gfx.ip_discovery_version = expected.hw_ip_compute.ip_discovery_version = 0xc0001;
+   assert(acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   assert(!memcmp(&out, &expected, sizeof(out)));
+   assert(!memcmp(&canned, &original, sizeof(canned)));
