+   assert(!memcmp(&out, &unchanged, sizeof(out)));
+   bad_template = canned;
+   bad_template.dev.virtual_address_offset = 0x222000;
+   bad_template.mem.vram.total_heap_size = 0x333000;
+   bad_template.dev.ids_flags = 0x55;
+   bad_template.mmr_regs[5] = 0xabcdef01;
+   assert(acd_runtime_overlay(&bad_template, &identity, &runtime, &out));
+   assert(out.dev.virtual_address_offset == 0x222000);
+   assert(out.mem.vram.total_heap_size == 0x333000 && out.dev.ids_flags == 0x55);
+   assert(out.mmr_regs[5] == 0xabcdef01);
+   assert(!acd_runtime_overlay(NULL, &identity, &runtime, &out));
+   assert(!acd_runtime_overlay(&canned, NULL, &runtime, &out));
+   assert(!acd_runtime_overlay(&canned, &identity, &runtime, NULL));
+
+   identity.shader_engines = 4;
+   identity.max_compute_units = 64;
+   struct amdgpu_device before_rejection = out;
+   assert(!acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   assert(!memcmp(&out, &before_rejection, sizeof(out)));
+   identity.shader_engines = 2;
+   identity.max_compute_units = 32;
+   identity.flags |= COBALT_GPU_INFO_BRINGUP_ENABLED;
+   struct cobalt_gpu_info_v1 invalid_identity;
+   assert(!cobalt_gpu_info_v1_decode(&identity, sizeof(identity), &invalid_identity));
+   before_rejection = out;
    assert(!acd_runtime_overlay(&canned, &identity, &runtime, &out));
+   assert(!memcmp(&out, &before_rejection, sizeof(out)));
    puts("acd_runtime_test: passed");
    return 0;
 }
