diff --git a/src/amd/common/darwin/test/acd_gpu_info_test.c b/src/amd/common/darwin/test/acd_gpu_info_test.c
new file mode 100644
index 0000000..7e5c9b6
--- /dev/null
+++ b/src/amd/common/darwin/test/acd_gpu_info_test.c
@@ -0,0 +1,116 @@
+#include "ac_darwin_runtime.h"
+#include "ac_darwin_identity.h"
+#include "common/ac_gpu_info.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define CHECK(condition) do { \
+   if (!(condition)) { \
+      fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #condition); \
+      return EXIT_FAILURE; \
+   } \
+} while (0)
+
+static int
+check_gpu_info(const struct amdgpu_device *device, enum radeon_family family,
+               unsigned num_cu, unsigned num_se, unsigned rb_mask,
+               unsigned bus_width, unsigned l2_kib, unsigned l3_mib)
+{
+   struct radeon_info info = {0};
+   info.ip[AMD_IP_GFX].ver_major = device->hw_ip_gfx.hw_ip_version_major;
+   info.ip[AMD_IP_GFX].ver_minor = device->hw_ip_gfx.hw_ip_version_minor;
+   info.ip[AMD_IP_GFX].ver_rev = device->hw_ip_gfx.ip_discovery_version & 0xff;
+   info.has_graphics = true;
+   CHECK(ac_identify_chip(&info, &device->dev));
+   CHECK(info.family == family && info.gfx_level == GFX12);
+   CHECK(info.pci_id == device->dev.device_id && info.pci_rev_id == device->dev.pci_rev);
+   CHECK(info.chip_external_rev == device->dev.external_rev);
+   ac_fill_memory_info(&info, &device->dev, &device->mem);
+   ac_fill_hw_info(&info, &device->dev);
+   CHECK(info.max_se == device->dev.num_shader_engines && info.max_sa_per_se == 2);
+   CHECK(info.num_cu == num_cu && info.num_se == num_se);
+   CHECK(info.enabled_rb_mask == rb_mask);
+   CHECK(info.memory_bus_width == bus_width);
+   CHECK(info.l2_cache_size == l2_kib * 1024 && info.l3_cache_size_mb == l3_mib);
+   CHECK(info.num_tcc_blocks == device->dev.num_tcc_blocks);
+   CHECK(info.clock_crystal_freq == 100000);
+   CHECK(info.max_gpu_freq_mhz == device->dev.max_engine_clock / 1000);
+   CHECK(info.high_va_offset == device->dev.high_va_offset);
+   CHECK(info.virtual_address_max == device->dev.virtual_address_max);
+   return EXIT_SUCCESS;
+}
+
+int
+main(void)
+{
+   const struct amdgpu_device *base = NULL;
+   for (size_t i = 0; i < num_amdgpu_devices; i++)
+      if (!strcmp(amdgpu_devices[i].name, "gfx1201"))
+         base = &amdgpu_devices[i];
+   CHECK(base);
+   const struct amdgpu_device original = *base;
+   struct cobalt_gpu_info_v1 identity = {
+      .version = 1, .size = sizeof(identity), .flags = COBALT_GPU_INFO_CAPACITY_VALID,
+      .pci_vendor = 0x1002, .pci_device = 0x7590, .pci_revision = 0xc0,
+      .gfx_target = 1200, .gc_major = 12,
+      .shader_engines = 2, .shader_arrays_per_engine = 2, .wgp_per_array = 4,
+      .cu_per_array = 8, .max_compute_units = 32,
+      .render_backends_per_engine = 4, .max_waves_per_simd = 16,
+   };
+   struct cobalt_gfx_runtime_v1 runtime = {
+      .version = 1, .size = sizeof(runtime), .flags = COBALT_GFX_RUNTIME_VALID,
+      .gc_version = 0xc0000, .gb_addr_config = 0x08200545,
+      .shader_engines = 2, .shader_arrays_per_engine = 2, .cu_per_array = 8,
+      .render_backends_per_engine = 4, .active_sa_mask = 0xf,
+      .active_rb_mask = 0xff, .active_cu_count = 32,
+      .cu_bitmap = {{0xff, 0xff}, {0xff, 0xff}},
+   };
+   struct amdgpu_device target;
+   CHECK(acd_runtime_overlay(base, &identity, &runtime, &target));
+   CHECK(check_gpu_info(&target, CHIP_GFX1200, 32, 2, 0xff, 128, 4096, 32) == EXIT_SUCCESS);
+   CHECK(target.dev.external_rev == 0x41 && target.radeon_family == CHIP_GFX1200);
+   CHECK(target.fw_gfx_me.ver == 0 && target.fw_gfx_pfp.ver == 0 && target.fw_gfx_mec.ver == 0);
+   CHECK(target.dev.ids_flags == base->dev.ids_flags);
+   CHECK(!memcmp(&target.mem, &base->mem, sizeof(target.mem)));
+   CHECK(target.dev.virtual_address_offset == base->dev.virtual_address_offset);
+   CHECK(target.dev.virtual_address_max == base->dev.virtual_address_max);
+   CHECK(target.dev.high_va_offset == base->dev.high_va_offset);
+   CHECK(target.dev.high_va_max == base->dev.high_va_max);
+   struct cobalt_gpu_info_v1 decoded;
+   CHECK(acd_identity_decode(&identity, sizeof(identity), &decoded) != NULL);
+
+   runtime.active_sa_mask = 0x3;
+   runtime.active_rb_mask = 0xf;
+   runtime.active_cu_count = 16;
+   runtime.cu_bitmap[1][0] = runtime.cu_bitmap[1][1] = 0;
+   CHECK(acd_runtime_overlay(base, &identity, &runtime, &target));
+   CHECK(check_gpu_info(&target, CHIP_GFX1200, 16, 1, 0xf, 128, 4096, 32) == EXIT_SUCCESS);
+   CHECK(target.dev.num_shader_engines == 2 && target.dev.num_rb_pipes == 8);
+
+   identity.flags |= COBALT_GPU_INFO_BRINGUP_ENABLED;
+   identity.pci_device = 0x7550;
+   identity.gfx_target = 1201;
+   identity.gc_revision = 1;
+   identity.shader_engines = runtime.shader_engines = 4;
+   identity.max_compute_units = 64;
+   runtime.gc_version = 0xc0001;
+   runtime.active_sa_mask = 0xff;
+   runtime.active_rb_mask = 0xffff;
+   runtime.active_cu_count = 64;
+   for (unsigned se = 0; se < 4; se++)
+      for (unsigned sa = 0; sa < 2; sa++)
+         runtime.cu_bitmap[se][sa] = 0xff;
+   CHECK(acd_runtime_overlay(base, &identity, &runtime, &target));
+   CHECK(check_gpu_info(&target, CHIP_GFX1201, 64, 4, 0xffff, 256, 8192, 64) == EXIT_SUCCESS);
+   CHECK(!memcmp(base, &original, sizeof(original)));
+
+   struct radeon_info info = {0};
+   info.ip[AMD_IP_GFX].ver_major = 12;
+   target.dev.external_rev = 0x4f;
+   CHECK(ac_identify_chip(&info, &target.dev) && info.family == CHIP_GFX1200);
+   target.dev.external_rev = 0x50;
+   CHECK(ac_identify_chip(&info, &target.dev) && info.family == CHIP_GFX1201);
+   puts("acd_gpu_info_test: passed");
+   return EXIT_SUCCESS;
+}
