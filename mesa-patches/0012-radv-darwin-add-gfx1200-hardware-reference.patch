+      reference.dev.gpu_counter_freq = 100000;
+      reference.dev.max_engine_clock = 2780000;
+      reference.dev.max_memory_clock = 1258000;
+      reference.dev.min_engine_clock = 500000;
+      reference.dev.min_memory_clock = 96000;
+      reference.dev.num_shader_engines = 2;
+      reference.dev.num_shader_arrays_per_engine = 2;
+      reference.dev.num_cu_per_sh = 8;
+      reference.dev.num_hw_gfx_contexts = 8;
+      reference.dev.vram_type = 9;
+      reference.dev.vram_bit_width = 128;
+      reference.dev.num_tcc_blocks = 16;
+      reference.dev.tcc_disabled_mask = 0;
+      reference.dev.wave_front_size = 32;
+      reference.dev.num_shader_visible_vgprs = 1536;
+      reference.dev.gc_double_offchip_lds_buf = 64;
+      reference.dev.gs_vgt_table_depth = 32;
+      reference.dev.gs_prim_buffer_depth = 1792;
+      reference.dev.max_gs_waves_per_vgt = 32;
+      reference.dev.tcp_cache_size = 32;
+      reference.dev.num_sqc_per_wgp = 1;
+      reference.dev.sqc_data_cache_size = 16;
+      reference.dev.sqc_inst_cache_size = 32;
+      reference.dev.gl1c_cache_size = 256;
+      reference.dev.gl2c_cache_size = 4096;
+      reference.dev.mall_size = UINT64_C(33554432);
+   }
+
+   reference.dev.device_id = checked_identity.pci_device;
+   reference.dev.pci_rev = checked_identity.pci_revision;
+   *out = reference;
+   return true;
+}
